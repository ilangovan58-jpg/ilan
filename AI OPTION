<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nifty Options Analyst · DeepSeek</title>
    <style>
        * { box-sizing: border-box; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
        body { background: #f5f7fb; display: flex; justify-content: center; padding: 2rem 1rem; margin: 0; }
        .container { max-width: 1000px; width: 100%; background: white; border-radius: 24px; box-shadow: 0 12px 30px rgba(0,0,0,0.1); padding: 2rem; }
        h1 { font-size: 1.8rem; font-weight: 600; margin-top: 0; margin-bottom: 0.25rem; color: #1e293b; display: flex; align-items: center; gap: 8px; }
        h1 small { font-size: 0.9rem; font-weight: 400; color: #64748b; margin-left: 8px; }
        .sub { color: #475569; margin-bottom: 2rem; border-left: 4px solid #3b82f6; padding-left: 1rem; background: #f8fafc; border-radius: 0 8px 8px 0; }
        .input-group { margin-bottom: 1.5rem; }
        label { font-weight: 500; display: block; margin-bottom: 6px; color: #334155; }
        input, button { width: 100%; padding: 12px 16px; font-size: 1rem; border-radius: 14px; border: 1px solid #cbd5e1; transition: 0.2s; }
        input:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.2); }
        .row { display: flex; gap: 1rem; }
        .row .input-group { flex: 1; }
        button { background: #1e293b; color: white; font-weight: 600; border: none; cursor: pointer; margin-top: 1rem; }
        button:hover { background: #0f172a; }
        button:disabled { background: #94a3b8; cursor: not-allowed; }
        .result { margin-top: 2.5rem; background: #f8fafc; border-radius: 20px; padding: 1.8rem; border: 1px solid #e2e8f0; }
        .result h2 { margin-top: 0; font-size: 1.5rem; font-weight: 600; color: #0f172a; }
        .result-content { white-space: pre-wrap; font-family: 'JetBrains Mono', 'Fira Code', monospace; font-size: 0.9rem; line-height: 1.6; color: #1e293b; }
        .loading { display: flex; align-items: center; gap: 12px; color: #3b82f6; font-weight: 500; }
        .spinner { width: 24px; height: 24px; border: 3px solid #e2e8f0; border-top-color: #3b82f6; border-radius: 50%; animation: spin 1s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .error { background: #fee2e2; border: 1px solid #ef4444; border-radius: 14px; padding: 1rem; color: #b91c1c; margin-top: 1rem; }
        .disclaimer { font-size: 0.8rem; color: #64748b; margin-top: 2rem; text-align: center; border-top: 1px solid #e2e8f0; padding-top: 1.5rem; }
        .info-note { background: #e6f7ff; border-left: 4px solid #1890ff; padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1.5rem; }
    </style>
</head>
<body>
<div class="container">
    <h1>📈 Nifty 50 Options Analyst <small>by DeepSeek (free API)</small></h1>
    <div class="sub">Intraday probabilities · Option strategies · High‑risk approach</div>

    <div class="info-note">
        ⚡ Get your free API key from <a href="https://platform.deepseek.com/api_keys" target="_blank">platform.deepseek.com</a> (credits included).<br>
        The analysis is simulated — no live data is used, only your inputs and the model’s knowledge.
    </div>

    <div class="row">
        <div class="input-group">
            <label>🔑 DeepSeek API Key</label>
            <input type="password" id="apiKey" placeholder="sk-..." value="">
        </div>
    </div>

    <div class="row">
        <div class="input-group">
            <label>📊 Nifty 50 Current Level</label>
            <input type="number" id="niftyLevel" step="0.01" value="23151.10">
        </div>
    </div>

    <div class="row">
        <div class="input-group">
            <label>📅 Weekly Expiry (e.g., 2026-03-17)</label>
            <input type="date" id="weeklyExpiry" value="2026-03-17">
        </div>
        <div class="input-group">
            <label>📅 Monthly Expiry (e.g., 2026-03-31)</label>
            <input type="date" id="monthlyExpiry" value="2026-03-31">
        </div>
    </div>

    <button id="generateBtn">🔮 Generate Analysis</button>

    <div id="loading" class="loading" style="display: none; margin-top: 1.5rem;">
        <div class="spinner"></div> Calling DeepSeek API ... (may take 10–20 seconds)
    </div>

    <div id="error" class="error" style="display: none;"></div>

    <div class="result" id="result" style="display: none;">
        <h2>📋 Analysis Report</h2>
        <div id="resultContent" class="result-content"></div>
    </div>

    <div class="disclaimer">
        ⚠️ This tool is for educational and informational purposes only. It does not constitute financial advice.
        Trading options involves substantial risk. Past performance does not guarantee future results.
        Always consult a qualified advisor before making investment decisions.
    </div>
</div>

<script>
    const generateBtn = document.getElementById('generateBtn');
    const apiKeyInput = document.getElementById('apiKey');
    const niftyInput = document.getElementById('niftyLevel');
    const weeklyInput = document.getElementById('weeklyExpiry');
    const monthlyInput = document.getElementById('monthlyExpiry');
    const loadingDiv = document.getElementById('loading');
    const errorDiv = document.getElementById('error');
    const resultDiv = document.getElementById('result');
    const resultContent = document.getElementById('resultContent');

    generateBtn.addEventListener('click', async () => {
        // Reset displays
        errorDiv.style.display = 'none';
        resultDiv.style.display = 'none';
        loadingDiv.style.display = 'flex';
        generateBtn.disabled = true;

        const apiKey = apiKeyInput.value.trim();
        const niftyLevel = niftyInput.value.trim();
        const weeklyExpiry = weeklyInput.value;
        const monthlyExpiry = monthlyInput.value;

        if (!apiKey) {
            showError('Please enter your DeepSeek API key.');
            return;
        }
        if (!niftyLevel || !weeklyExpiry || !monthlyExpiry) {
            showError('Please fill in all fields.');
            return;
        }

        // Prepare prompt
        const today = new Date().toISOString().split('T')[0]; // YYYY-MM-DD
        const userPrompt = `You are an expert financial analyst specializing in the Indian equity and derivatives markets, especially Nifty50 Options. The current Nifty50 index level is <${niftyLevel}>. Using a combination of: Technical analysis (candlestick patterns, intraday indicators, support/resistance, implied volatility, option Greeks, etc.) Fundamental analysis (macroeconomic cues, FII/DII flows, sectoral news, global markets impact) Real-time news sentiment (headlines, corporate announcements, RBI commentary, geopolitical developments) Produce a short report with intraday probability estimates (in percentages) for whether Nifty 50 will move: 1, Upside 2, Downside 3, volatile market (market maybe goes big up or down) Specifically: 1. Starting from the current index level, calculate the probability (in %) that the index will finish the trading day higher, lower, or roughly flat. Clearly state your assumption (e.g., what technical patterns or news you're emphasizing). 2. Based on the probabilities, recommend which option-buying near ATM call and put is likely to yield the highest expected profit today: Buying Call option only near ATM Buying Put option only near ATM For each strategy, estimate the expected return (percentage) and mention any major risks (e.g., sudden volatility spikes, unexpected news). I want to trade between 9:15am and 3:30pm. let's assume a high-risk approach. I will take <CURRENT MONTHLY EXPIRY ${monthlyExpiry}> and <CURRENT WEEKLY EXPIRY ${weeklyExpiry}> At the end, provide a concise Actionable summary •Which specific strategy should I execute . Buy calls, buy puts or both buy? •Which strikes would you choose if you were trading intraday? •Approximately what premium (₹) and probability (%) does each recommended position carry. Use today's date ${today} for context. Be realistic and specific, incorporating plausible current market conditions (like recent trends, global cues, FII activity, etc.) based on your knowledge up to your cutoff date. However, note that you don't have live data, so your analysis will be simulated.`;

        try {
            const response = await fetch('https://api.deepseek.com/v1/chat/completions', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${apiKey}`
                },
                body: JSON.stringify({
                    model: 'deepseek-chat',  // use 'deepseek-reasoner' if you prefer
                    messages: [
                        { role: 'system', content: 'You are an expert financial analyst. Provide detailed, structured analysis with probabilities, option strategies, and risks. Output in markdown with clear sections.' },
                        { role: 'user', content: userPrompt }
                    ],
                    temperature: 0.7,
                    max_tokens: 2048
                })
            });

            if (!response.ok) {
                const errData = await response.json();
                throw new Error(`API error ${response.status}: ${errData.error?.message || 'Unknown error'}`);
            }

            const data = await response.json();
            const analysisText = data.choices[0].message.content;

            // Display result
            resultContent.textContent = analysisText;  // using textContent to preserve formatting; you can replace with markdown renderer if desired
            resultDiv.style.display = 'block';
        } catch (err) {
            showError(err.message);
        } finally {
            loadingDiv.style.display = 'none';
            generateBtn.disabled = false;
        }
    });

    function showError(msg) {
        errorDiv.textContent = '❌ ' + msg;
        errorDiv.style.display = 'block';
        loadingDiv.style.display = 'none';
        generateBtn.disabled = false;
    }
</script>
</body>
</html>
